# Backend Configuration
# Options: "gateway" (default, recommended) or "local"
PROVENANCE_BACKEND=gateway

# Gateway Settings (when PROVENANCE_BACKEND=gateway)
# No local Bee node required
PROVENANCE_GATEWAY_URL=https://provenance-gateway.datafund.io

# Local Bee Settings (when PROVENANCE_BACKEND=local)
# Requires a running Bee node
BEE_GATEWAY_URL=http://localhost:1633

# Default Postage Stamp Parameters
DEFAULT_POSTAGE_DEPTH=17
# Duration in hours for stamp validity (gateway only, min 24)
DEFAULT_POSTAGE_DURATION_HOURS=25
# Legacy: PLUR amount (for local backend)
DEFAULT_POSTAGE_AMOUNT=1000000000

# --- Free Tier Mode (optional) ---
# Use gateway free tier (rate-limited to 3 req/min, no wallet needed)
# FREE_TIER=true

# --- x402 Payment Configuration (optional) ---
# Enable x402 pay-per-request mode (USDC on Base chain)
# X402_ENABLED=true

# Your wallet private key (keep secret!)
# X402_PRIVATE_KEY=0x...

# Optional: read the key from a variable with another name instead. When set,
# only that variable is read (no fallback to X402_PRIVATE_KEY).
# X402_PRIVATE_KEY_ENV=MY_WALLET_KEY

# Network: "base-sepolia" (testnet, default) or "base" (mainnet)
# X402_NETWORK=base-sepolia

# Auto-pay without prompting (up to max limit)
# X402_AUTO_PAY=false

# Maximum auto-pay amount per request in USD
# X402_MAX_AUTO_PAY_USD=1.00

# Custom RPC URL for USDC balance and EIP-712 domain checks
# (optional, uses the network preset if not set)
# X402_RPC_URL=

# --- Chain / Blockchain Configuration (optional) ---
# Chain: "base-sepolia" (testnet, default) or "base" (mainnet)
# CHAIN_NAME=base-sepolia

# Your wallet private key for signing transactions (keep secret!)
# PROVENANCE_WALLET_KEY=0x...

# Custom RPC URL (optional, overrides preset for selected chain)
# CHAIN_RPC_URL=

# Fallback RPC URLs, comma-separated (optional, replace the preset fallbacks)
# CHAIN_RPC_URLS=

# Custom contract address (optional, overrides preset)
# CHAIN_CONTRACT=

# Custom block explorer URL (optional, overrides preset)
# CHAIN_EXPLORER_URL=

# Explicit gas limit (optional, skips RPC estimation when set)
# CHAIN_GAS_LIMIT=500000

# --- Notary verification (download) ---
# Expected notary signer for downloaded documents. Without it the address is
# taken from the gateway that served the document. One pin for all gateways.
# NOTARY_ADDRESS=0x...
